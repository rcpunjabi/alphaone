Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve certificate validation before enforcing the canonical host.
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # Consolidate legacy URLs that Search Console still sees as 404s.
  RewriteRule ^blog/?$ https://www.alphaonegarage.com/blog.html [R=301,L,NE]
  RewriteRule ^garage-door-services/?$ https://www.alphaonegarage.com/ [R=301,L,NE]

  # Serve one HTTPS production host so crawlers receive a single canonical URL.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.alphaonegarage\.com$ [NC]
  RewriteRule ^ https://www.alphaonegarage.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|png|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
